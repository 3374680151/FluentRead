  "url": "https://bsky.app/profile/example.test",
  "html": "<main>\n<div id=\"profile-identity\"><div><div data-testid=\"profileHeaderDisplayName\" id=\"profile-name\">Fixture Social Account</div></div><div><div dir=\"auto\" id=\"profile-header-handle\">@fixture.account</div></div></div>\n<div id=\"profile-details\"><div id=\"profile-counts\"><a data-testid=\"profileHeaderFollowersButton\" href=\"/profile/fixture.account/followers\">987 followers</a><a data-testid=\"profileHeaderFollowsButton\" href=\"/profile/fixture.account/follows\">23 following</a><div dir=\"auto\" id=\"profile-post-count\">321 posts</div></div><div><div data-testid=\"profileHeaderDescription\" id=\"profile-bio\">This public profile describes an independent reading project and its latest updates.</div></div></div>\n<div data-testid=\"feedItem-by-fixture.example\" role=\"link\" tabindex=\"0\" id=\"card\">\n  <div>\n    <a id=\"author\" href=\"/profile/fixture.example\" aria-label=\"View profile\" dir=\"auto\">A Fixture Author With A Long Name</a>\n    <a id=\"handle\" href=\"/profile/fixture.example\" aria-label=\"View profile\" dir=\"auto\">@fixture.example</a>\n    <a id=\"post-time\" href=\"/profile/fixture.example/post/example\" data-tooltip=\"Earlier this week\" aria-label=\"Earlier this week\">Earlier this week</a>\n  </div>\n  <div data-testid=\"contentHider-post\"><div>\n    <div data-testid=\"postText\" id=\"body1\">This first post explains <span id=\"dirty\">an important example of ordinary readable prose</span> and keeps <code id=\"code\">ORIGINAL_CODE_TOKEN</code> intact.</div>\n    <div data-testid=\"postText\" id=\"body2\">This second post thanks <a id=\"mention\" aria-label=\"View profile\" dir=\"auto\" href=\"/profile/reader.example\">@reader.example</a> for sharing <a id=\"reading-link\" href=\"https://example.test/reading\">an ordinary reading reference</a> with the community.</div>\n  </div></div>\n  <div id=\"count-actions\">\n    <div><button data-testid=\"replyBtn\" id=\"reply\"><span>348</span></button></div>\n    <div><button><span data-testid=\"repostCount\" id=\"reposts\">2万</span></button></div>\n    <div><button data-testid=\"likeBtn\"><div><span data-testid=\"likeCount\" id=\"likes\">8万</span></div></button></div>\n  </div>\n</div>\n<section><div id=\"outside-prose\">This independent explanation remains readable outside the feed metadata.</div>\n<a id=\"outside-profile-reference\" href=\"/profile/other.example\" aria-label=\"View profile\" dir=\"auto\">An ordinary profile reference outside a feed item</a>\n<div id=\"outside-count-lookalike\"><div><button data-testid=\"replyBtn\">A general reply operation</button></div><div><span data-testid=\"likeCount\">A prose label outside the observed feed card</span></div></div></section>\n<input id=\"search\" type=\"search\" value=\"A private search value\">\n<div contenteditable=\"true\" id=\"editor\">A private editable draft remains original</div>\n</main>",
